# 실제 키는 .env.local 또는 배포 환경(Amplify Environment Variables)에만 두세요.
# 본 파일은 어떤 환경변수가 필요한지 보여주는 예시입니다.

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ─── 관리자 (모더레이션) ───
# /admin?token=XXX 페이지 접근용 비밀 토큰
ADMIN_SECRET_TOKEN=set_a_long_random_string_here
# Supabase 관리자 작업(의견 숨김·삭제)용 service_role 키 — 절대 공개 X
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Naver Map API ───
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_client_id

# ─── Cloudflare Turnstile (스팸 방지) ───
# https://dash.cloudflare.com/?to=/:account/turnstile 에서 발급
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
